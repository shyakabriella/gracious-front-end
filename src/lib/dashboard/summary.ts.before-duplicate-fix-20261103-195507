import "server-only";

import {
  getAuthToken,
  laravelRequest,
} from "@/lib/auth/server";

export type Metric = {
  label: string;
  value: number;
};

export type StatusMetric = {
  label: string;
  value: number;
};

export type PropertyDashboardCounts = {
  total: number;
  draft: number;
  verified: number;
  published: number;
  for_sale: number;
};

type SummaryResult = {
  metrics: Metric[];
  statuses: StatusMetric[];
  properties: PropertyDashboardCounts | null;
  error: string | null;
};

function isObject(
  value: unknown
): value is Record<string, unknown> {
  return (
    typeof value === "object" &&
    value !== null &&
    !Array.isArray(value)
  );
}

function readable(value: string): string {
  return value
    .replaceAll("_", " ")
    .replace(/([a-z])([A-Z])/g, "$1 $2")
    .replace(/\b\w/g, (letter) => letter.toUpperCase());
}

function collectCounts(
  value: unknown,
  prefix = "",
  depth = 0
): Metric[] {
  if (!isObject(value) || depth > 4) return [];

  const result: Metric[] = [];

  for (const [key, item] of Object.entries(value)) {
    const label = prefix
      ? `${prefix} · ${readable(key)}`
      : readable(key);

    if (
      typeof item === "number" &&
      Number.isFinite(item) &&
      item >= 0 &&
      Number.isInteger(item) &&
      !/amount|revenue|income|price|balance|rate|percentage|percent|currency|year|month|day|id$/i.test(key)
    ) {
      result.push({ label, value: item });
    } else if (isObject(item)) {
      result.push(...collectCounts(item, label, depth + 1));
    }
  }

  return result;
}

function findStatusCounts(
  value: unknown,
  depth = 0
): StatusMetric[] {
  if (!isObject(value) || depth > 4) return [];

  // Look for a genuine status breakdown.
  for (const [key, item] of Object.entries(value)) {
    if (
      /by_status|statuses|status_counts/i.test(key) &&
      isObject(item)
    ) {
      const entries = Object.entries(item)
        .filter(
          (entry): entry is [string, number] =>
            typeof entry[1] === "number" &&
            Number.isInteger(entry[1]) &&
            entry[1] >= 0
        )
        .map(([label, count]) => ({
          label,
          value: count,
        }));

      if (entries.length >= 2) return entries;
    }

    if (isObject(item)) {
      const nested = findStatusCounts(item, depth + 1);
      if (nested.length) return nested;
    }
  }

  return [];
}

function readPropertyCounts(
  value: unknown
): PropertyDashboardCounts | null {
  if (!isObject(value) || value.available !== true) {
    return null;
  }

  const keys = [
    "total",
    "draft",
    "verified",
    "published",
    "for_sale",
  ] as const;

  const counts: Record<string, number> = {};

  for (const key of keys) {
    const number = value[key];

    if (
      typeof number !== "number" ||
      !Number.isSafeInteger(number) ||
      number < 0
    ) {
      return null;
    }

    counts[key] = number;
  }

  return counts as PropertyDashboardCounts;
}

export async function getDashboardSummary(): Promise<SummaryResult> {
  const token = await getAuthToken();

  if (!token) {
    return {
      metrics: [],
      properties: null,
      statuses: [],
      error: "Your session is unavailable.",
    };
  }

  try {
    const response = await laravelRequest(
      "/dashboard/summary",
      token
    );

    if (response.status === 403) {
      return {
        metrics: [],
        properties: null,
      properties: null,
        statuses: [],
        error: "Your account cannot view dashboard statistics.",
      };
    }

    if (!response.ok) {
      return {
        metrics: [],
        properties: null,
      properties: null,
        statuses: [],
        error: "Unable to retrieve dashboard statistics.",
      };
    }

    const data: unknown = await response.json();

    if (!isObject(data) || !isObject(data.statistics)) {
      return {
        metrics: [],
        properties: null,
      properties: null,
        statuses: [],
        error: "The backend returned no usable statistics.",
      };
    }

    return {
      metrics: collectCounts(data.statistics),
      statuses: findStatusCounts(data.statistics),
      properties: readPropertyCounts(
        data.statistics.properties
      ),
      error: null,
    };
  } catch {
    return {
      metrics: [],
      properties: null,
      statuses: [],
      error: "Cannot connect to the Laravel API.",
    };
  }
}
